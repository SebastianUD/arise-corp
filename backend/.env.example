# Copiar este archivo como .env y completar los valores reales.
# No introducir comillas ni la palabra 'export'.
# El .env real nunca debe subirse a Git.

SUPABASE_DB_HOST=HOST_DEL_SESSION_POOLER
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=USUARIO_DEL_SESSION_POOLER
SUPABASE_DB_PASSWORD=REEMPLAZAR_CON_LA_CONTRASENA_DE_POSTGRESQL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co